            </li>
            <li class="nav-item">
              <a class="nav-link" href="#jobs"><i class="bi bi-cpu me-1"></i>Task Queue</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#server-cache"><i class="bi bi-lightning-charge me-1"></i>Cache & Logs</a>
