            <li class="nav-item">
              <a class="nav-link" href="#register"><i class="bi bi-pencil-square me-1"></i>Registration</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#dashboard"><i class="bi bi-database me-1"></i>Manage Records</a>
