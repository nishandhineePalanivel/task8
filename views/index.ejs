  <!-- MAIN CONTENT CONTAINER -->
  <main style="padding-top: 76px;">

    <!-- Global API Notification Banner Container -->
    <div class="container pt-3">
      <div id="api-notification-alert" style="display: none;"></div>
    </div>

    <!-- SPA Main Content Container -->
    <div id="main-portal-content">

      <!-- 2. HERO SECTION -->
      <section id="home" class="hero-section">
        <div class="container">
          <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-7 animate-fade-in-up">
              <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-white border border-slate-200 shadow-sm mb-3">
                <span class="badge bg-primary rounded-pill">Task 8</span>
                <span class="small fw-bold text-muted">Advanced Server-Side Where Data Meets Intelligence</span>
              </div>
              
              <h1 class="hero-title mb-3">
                Enterprise Backend Engine with <span class="hero-gradient-text">Task Queues & Server Caching</span>
              </h1>
              
              <p class="hero-subtitle mb-4">
                Architected with a structured request processing pipeline (Request ID tracking, audit logging, security hardening), an asynchronous background task queue engine, and high-performance server-side caching with automated mutation invalidation.
              </p>

              <div class="d-flex flex-column flex-sm-row gap-3">
                <a href="#jobs" class="btn btn-custom-primary">
                  <i class="bi bi-cpu-fill"></i> Launch Background Task Queue
                </a>
                <a href="#server-cache" class="btn btn-custom-secondary">
                  <i class="bi bi-lightning-charge-fill"></i> Monitor Cache & Audit Logs
                </a>
              </div>

              <div class="mt-4 pt-3 d-flex flex-wrap align-items-center gap-4 text-muted small border-top">
                <span><i class="bi bi-gear-wide-connected text-primary me-1"></i> Asynchronous Job Queue</span>
                <span><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Server Caching (&lt;1ms)</span>
                <span><i class="bi bi-file-earmark-code-fill text-success me-1"></i> Request ID & Audit Logger</span>
              </div>
            </div>

            <div class="col-lg-5">
              <div class="hero-card-illustration p-4 rounded-4 bg-white border shadow-lg">
                <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                  <div class="bg-primary text-white rounded-3 p-3 fs-4 d-flex align-items-center justify-center">
                    <i class="bi bi-hdd-network-fill"></i>
                  </div>
                  <div>
                    <h3 class="h6 mb-0 font-heading fw-bold">Advanced Server Pipeline</h3>
                    <small class="text-muted font-mono">Middleware + Queue + Cache v8.0</small>
                  </div>
                </div>

                <div class="p-3 bg-light rounded-3 mb-3 border">
                  <div class="d-flex justify-content-between text-muted small mb-1">
                    <span>Cache Hit Efficiency</span>
                    <span id="hero-cache-hit-ratio" class="text-success fw-bold font-mono"><i class="bi bi-lightning-fill me-1"></i> 100.0% Optimized</span>
                  </div>
                  <div class="progress" style="height: 6px;">
                    <div id="hero-cache-progress-bar" class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                  </div>
                </div>

                <div class="row g-2 text-center small">
                  <div class="col-6">
                    <div class="p-2 border rounded bg-white font-mono">
                      <strong class="d-block text-primary" style="font-size: 0.75rem;">Background Queue</strong>
                      <span class="text-muted" style="font-size: 0.7rem;">Bull/Redis Architecture</span>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="p-2 border rounded bg-white font-mono">
                      <strong class="d-block text-success" style="font-size: 0.75rem;">Server-Side Cache</strong>
                      <span class="text-muted" style="font-size: 0.7rem;">TTL & Auto Eviction</span>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="p-2 border rounded bg-white font-mono">
                      <strong class="d-block text-warning" style="font-size: 0.75rem;">X-Request-Id</strong>
                      <span class="text-muted" style="font-size: 0.7rem;">Correlation Tracking</span>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="p-2 border rounded bg-white font-mono">
                      <strong class="d-block text-danger" style="font-size: 0.75rem;">Audit Logger</strong>
                      <span class="text-muted" style="font-size: 0.7rem;">High-Res hrtime() ms</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. ABOUT SECTION -->
      <section id="about" class="py-5 bg-white border-top border-bottom">
        <div class="container py-4">
          <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
              <span class="text-primary fw-bold text-uppercase tracking-wider small d-block mb-1">Architecture Overview</span>
              <h2 class="display-6 fw-bold mb-3">Where Data Meets Intelligence</h2>
              <p class="text-muted">Enterprise backend engineered with asynchronous background job workers, sub-millisecond in-memory caching, and request lifecycle telemetry.</p>
            </div>
          </div>

          <div class="row g-4">
            <div class="col-6 col-md-3">
              <div class="stat-card">
                <div class="stat-number">&lt; 1 ms</div>
                <div class="stat-label">Cache Hit Latency</div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="stat-card">
                <div class="stat-number">2 Workers</div>
                <div class="stat-label">Concurrent Job Queue</div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="stat-card">
                <div class="stat-number">100%</div>
                <div class="stat-label">Audit Logged Requests</div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="stat-card">
                <div class="stat-number">Auto</div>
                <div class="stat-label">Mutation Cache Eviction</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 4. FEATURES SECTION -->
      <section id="features" class="py-5">
        <div class="container py-4">
          <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
              <span class="text-primary fw-bold text-uppercase tracking-wider small d-block mb-1">Task 8 Capabilities</span>
              <h2 class="display-6 fw-bold mb-3">Advanced Server-Side Features</h2>
              <p class="text-muted">Structured middleware, background workers, and performance caching designed for production scalability.</p>
            </div>
          </div>

          <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-4">
              <div class="feature-card">
                <div class="feature-icon bg-primary-light text-primary">
                  <i class="bi bi-cpu-fill"></i>
                </div>
                <h3 class="h5 font-heading fw-bold mb-2">Asynchronous Job Queue</h3>
                <p class="text-muted small mb-0">Processes long-running verification tasks, PDF report compiles, and database snapshots asynchronously with concurrency limits and live progress reporting.</p>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="feature-card">
                <div class="feature-icon bg-success-light text-success">
                  <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <h3 class="h5 font-heading fw-bold mb-2">Route-Level Caching</h3>
                <p class="text-muted small mb-0">Implements in-memory key-value caching returning `X-Cache: HIT` in &lt;1ms for read routes, with automatic cache invalidation on database mutations.</p>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="feature-card">
                <div class="feature-icon bg-warning-light text-warning">
                  <i class="bi bi-card-checklist"></i>
                </div>
                <h3 class="h5 font-heading fw-bold mb-2">High-Res Audit Logger</h3>
                <p class="text-muted small mb-0">Tracks request execution down to fractional milliseconds using `process.hrtime()`, logging client IP, user agent, and masked request bodies.</p>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="feature-card">
                <div class="feature-icon bg-info-light text-info">
                  <i class="bi bi-fingerprint"></i>
                </div>
                <h3 class="h5 font-heading fw-bold mb-2">Request ID Correlation</h3>
                <p class="text-muted small mb-0">Every HTTP transaction receives an `X-Request-Id` UUID header for end-to-end tracing across distributed server logs and microservices.</p>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="feature-card">
                <div class="feature-icon bg-danger-light text-danger">
                  <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3 class="h5 font-heading fw-bold mb-2">Security Hardening Headers</h3>
                <p class="text-muted small mb-0">Injects `nosniff`, `SAMEORIGIN`, and XSS protection headers alongside Express rate limiting to prevent denial-of-service and clickjacking.</p>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="feature-card">
                <div class="feature-icon bg-purple-light text-purple" style="background-color: #f3e8ff; color: #7e22ce;">
                  <i class="bi bi-diagram-3-fill"></i>
                </div>
                <h3 class="h5 font-heading fw-bold mb-2">Full Stack Continuity</h3>
                <p class="text-muted small mb-0">Preserves all features from Tasks 4, 5, 6, & 7 including JWT authentication, bcrypt encryption, external REST APIs, and OAuth 2.0.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. REGISTRATION FORM SECTION -->
      <section id="register" class="py-5 bg-light border-top">
        <div class="container py-4">
          <div class="row justify-content-center text-center mb-4">
            <div class="col-lg-8">
              <span class="badge bg-primary rounded-pill mb-2 font-mono">Task 4, 5, 6 Integration</span>
              <h2 class="display-6 fw-bold mb-2">Student Application Form</h2>
              <p class="text-muted">Fill in your information below with dynamic real-time validation and preview updates.</p>
            </div>
          </div>

          <div class="row g-4 justify-content-center">
            <div class="col-lg-7">
              <div class="registration-card bg-white border shadow-sm">
                
                <div id="form-success-banner" class="alert alert-success alert-dismissible fade show d-none" role="alert">
                  <i class="bi bi-check-circle-fill me-2"></i>
                  <span id="form-success-message">Form validated successfully!</span>
                </div>

                <form id="registration-form" novalidate>
                  <div class="mb-3">
                    <label for="name" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Nishandhinee M" required>
                    <div id="name-error" class="invalid-feedback"></div>
                  </div>

                  <div class="mb-3">
                    <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="e.g. nishandhinee@example.com" required>
                    <div id="email-error" class="invalid-feedback"></div>
                  </div>

                  <div class="row g-3 mb-3">
                    <div class="col-md-7">
                      <label for="phone" class="form-label">Phone Number (10-Digit Indian Mobile) <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <span class="input-group-text bg-light">+91</span>
                        <input type="tel" class="form-control" id="phone" name="phone" placeholder="9876543210" maxlength="10" required>
                      </div>
                      <div id="phone-error" class="invalid-feedback"></div>
                    </div>

                    <div class="col-md-5">
                      <label for="age" class="form-label">Age <span class="text-danger">*</span></label>
                      <input type="number" class="form-control" id="age" name="age" min="16" max="100" placeholder="e.g. 21" required>
                      <div id="age-error" class="invalid-feedback"></div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="course" class="form-label">Select Degree Program <span class="text-danger">*</span></label>
                    <select class="form-select" id="course" name="course" required>
                      <option value="" selected disabled>-- Choose Engineering Specialization --</option>
                      <option value="B.E. Electronics and Communication Engineering">B.E. Electronics and Communication Engineering</option>
                      <option value="B.E. Computer Science and Engineering">B.E. Computer Science and Engineering</option>
                      <option value="B.Tech Information Technology">B.Tech Information Technology</option>
                      <option value="B.E. Mechanical Engineering">B.E. Mechanical Engineering</option>
                      <option value="B.E. Electrical and Electronics Engineering">B.E. Electrical and Electronics Engineering</option>
                    </select>
                    <div id="course-error" class="invalid-feedback"></div>
                  </div>

                  <!-- Password Input & Strength Indicator -->
                  <div class="mb-3">
                    <label for="password" class="form-label">Account Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text bg-light"><i class="bi bi-lock-fill text-muted"></i></span>
                      <input 
                        type="password" 
                        class="form-control" 
                        id="password" 
                        name="password" 
                        placeholder="Create secure password" 
                        required
                      >
                      <button class="btn btn-outline-secondary" type="button" id="toggle-password" aria-label="Show Password">
                        <i class="bi bi-eye-fill"></i>
                      </button>
                    </div>
                    <div id="password-error" class="invalid-feedback"></div>

                    <!-- Dynamic Password Strength Progress Bar & Badge -->
                    <div class="mt-2 p-2.5 bg-light rounded border">
                      <div class="d-flex justify-content-between align-items-center mb-1.5 small">
                        <span class="fw-bold text-muted" style="font-size: 0.8rem;">Password Strength:</span>
                        <span id="password-strength-text" class="badge bg-secondary">None</span>
                      </div>
                      <div class="progress" style="height: 6px;">
                        <div id="password-strength-bar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                    </div>

                    <!-- Dynamic Password Requirement Checklist -->
                    <div class="mt-2 p-2.5 bg-white rounded border small">
                      <div class="fw-bold text-muted mb-1" style="font-size: 0.75rem;">Password Requirements Checklist:</div>
                      <ul class="list-unstyled mb-0 font-mono" style="font-size: 0.75rem;">
                        <li id="req-length" class="text-muted d-flex align-items-center gap-1.5 py-0.5"><i class="bi bi-circle text-muted"></i> Minimum 8 characters</li>
                        <li id="req-uppercase" class="text-muted d-flex align-items-center gap-1.5 py-0.5"><i class="bi bi-circle text-muted"></i> At least one uppercase letter (A-Z)</li>
                        <li id="req-lowercase" class="text-muted d-flex align-items-center gap-1.5 py-0.5"><i class="bi bi-circle text-muted"></i> At least one lowercase letter (a-z)</li>
                        <li id="req-number" class="text-muted d-flex align-items-center gap-1.5 py-0.5"><i class="bi bi-circle text-muted"></i> At least one number (0-9)</li>
                        <li id="req-special" class="text-muted d-flex align-items-center gap-1.5 py-0.5"><i class="bi bi-circle text-muted"></i> At least one special character (!@#$%^&*)</li>
                      </ul>
                    </div>
                  </div>

                  <!-- Confirm Password Input -->
                  <div class="mb-3">
                    <label for="confirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text bg-light"><i class="bi bi-lock-fill text-muted"></i></span>
                      <input 
                        type="password" 
                        class="form-control" 
                        id="confirmPassword" 
                        name="confirmPassword" 
                        placeholder="Re-enter password to match" 
                        required
                      >
                      <button class="btn btn-outline-secondary" type="button" id="toggle-confirm-password" aria-label="Show Password">
                        <i class="bi bi-eye-fill"></i>
                      </button>
                    </div>
                    <div id="confirmPassword-error" class="invalid-feedback"></div>
                  </div>

                  <!-- Terms Checkbox -->
                  <div class="mb-4 form-check">
                    <input type="checkbox" class="form-check-input" id="terms" name="terms" required>
                    <label class="form-check-label small text-muted" for="terms">
                      I agree to the <a href="#" class="text-primary text-decoration-none fw-semibold">Terms and Conditions</a> and declare all entered information is valid. <span class="text-danger">*</span>
                    </label>
                    <div id="terms-error" class="invalid-feedback"></div>
                  </div>

                  <!-- Submit Button -->
                  <button type="submit" id="submit-btn" class="btn btn-custom-primary w-100 py-3 font-heading fw-bold">
                    <i class="bi bi-send-check-fill me-1"></i> Submit Registration Application
                  </button>
                </form>
              </div>
            </div>

            <!-- Dynamic Registration Live Preview Column -->
            <div class="col-lg-5">
              <div class="registration-card h-100 bg-white border shadow-sm">
                <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                  <h3 class="h5 font-heading fw-bold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-eye-fill text-primary"></i> Live Application Preview
                  </h3>
                  <span class="badge bg-primary-light text-primary font-mono" style="font-size: 0.7rem;">Real-Time DOM</span>
                </div>

                <p class="text-muted small mb-4">
                  As you fill out the registration form, your details update instantly below in real time without refreshing the page.
                </p>

                <div class="d-flex flex-column gap-3">
                  <div class="p-3 bg-light rounded border">
                    <small class="text-muted text-uppercase tracking-wider fw-bold d-block mb-1" style="font-size: 0.7rem;">Full Name</small>
                    <span id="preview-name" class="fw-semibold text-dark d-block">Not entered</span>
                  </div>

                  <div class="p-3 bg-light rounded border">
                    <small class="text-muted text-uppercase tracking-wider fw-bold d-block mb-1" style="font-size: 0.7rem;">Email Address</small>
                    <span id="preview-email" class="fw-semibold text-dark d-block text-break">Not entered</span>
                  </div>

                  <div class="p-3 bg-light rounded border">
                    <small class="text-muted text-uppercase tracking-wider fw-bold d-block mb-1" style="font-size: 0.7rem;">Phone Number</small>
                    <span id="preview-phone" class="fw-semibold text-dark d-block">Not entered</span>
                  </div>

                  <div class="p-3 bg-light rounded border">
                    <small class="text-muted text-uppercase tracking-wider fw-bold d-block mb-1" style="font-size: 0.7rem;">Selected Course</small>
                    <span id="preview-course" class="fw-semibold text-dark d-block">Not selected</span>
                  </div>

                  <div class="p-3 bg-light rounded border d-flex justify-content-between align-items-center">
                    <div>
                      <small class="text-muted text-uppercase tracking-wider fw-bold d-block mb-0" style="font-size: 0.7rem;">Password Security</small>
                    </div>
                    <span id="preview-strength" class="badge bg-secondary">Not set</span>
                  </div>

